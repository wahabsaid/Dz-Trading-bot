import os
import logging
from telegram import InlineKeyboardButton, InlineKeyboardMarkup, Update
from telegram.ext import (
    Application,
    CommandHandler,
    CallbackQueryHandler,
    MessageHandler,
    ContextTypes,
    filters,
)

# =========================
# إعدادات البوت
# =========================

BOT_TOKEN = os.getenv("BOT_TOKEN")
ADMIN_ID = 6361798380

CHANNEL_USERNAME = "@Channel2025555"

MEXC_LINK = "https://www.mexc.com/ar-AE/acquisition/custom-sign-up?shareCode=mexc-127EQm"

SIGNALS_LINK = "https://t.me/+qFtGUCIHl5BlMzY0"

# =========================
# تسجيل الأخطاء
# =========================

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)

# =========================
# /start
# =========================

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    keyboard = [
        [
            InlineKeyboardButton(
                "📢 الاشتراك في القناة",
                url="https://t.me/Channel2025555",
            )
        ],
        [
            InlineKeyboardButton(
                "✅ تحقق من الاشتراك",
                callback_data="check_subscription",
            )
        ],
    ]

    await update.message.reply_text(
        "مرحبًا بك في بوت DZ TRADING 🚀\n\n"
        "للحصول على قناة توصيات التداول الفوري، يجب أولًا الاشتراك في قناة DZ TRADING.\n\n"
        "1️⃣ اشترك في القناة\n"
        "2️⃣ اضغط تحقق من الاشتراك",
        reply_markup=InlineKeyboardMarkup(keyboard),
    )


# =========================
# التحقق من الاشتراك
# =========================

async def check_subscription(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    user_id = query.from_user.id

    try:
        member = await context.bot.get_chat_member(
            chat_id=CHANNEL_USERNAME,
            user_id=user_id,
        )

        if member.status in ["member", "administrator", "creator"]:

            keyboard = [
                [
                    InlineKeyboardButton(
                        "💰 التسجيل في MEXC",
                        url=MEXC_LINK,
                    )
                ],
                [
                    InlineKeyboardButton(
                        "📤 إرسال UID",
                        callback_data="send_uid",
                    )
                ],
            ]

            await query.edit_message_text(
                "✅ تم التحقق من اشتراكك.\n\n"
                "الخطوة التالية:\n"
                "1️⃣ سجل في MEXC من الرابط الموجود بالأسفل.\n"
                "2️⃣ بعد التسجيل اضغط «📤 إرسال UID» وأرسل UID الخاص بحسابك.\n\n"
                "سيتم التحقق من UID يدويًا.",
                reply_markup=InlineKeyboardMarkup(keyboard),
            )

        else:
            await query.edit_message_text(
                "❌ لم يتم العثور على اشتراكك في القناة.\n\n"
                "اشترك أولًا ثم اضغط «تحقق من الاشتراك»."
            )

    except Exception:
        await query.edit_message_text(
            "⚠️ حدث خطأ أثناء التحقق.\n"
            "تأكد من الاشتراك في القناة ثم حاول مرة أخرى."
        )


# =========================
# طلب إرسال UID
# =========================

async def request_uid(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()

    context.user_data["waiting_for_uid"] = True

    await query.edit_message_text(
        "📤 أرسل الآن UID الخاص بحسابك في MEXC.\n\n"
        "مثال:\n"
        "12345678\n\n"
        "أرسل UID فقط."
    )


# =========================
# استقبال UID
# =========================

async def receive_uid(update: Update, context: ContextTypes.DEFAULT_TYPE):

    if not context.user_data.get("waiting_for_uid"):
        return

    uid = update.message.text.strip()

    user = update.effective_user

    context.user_data["waiting_for_uid"] = False

    # حفظ بيانات المستخدم مؤقتًا
    context.user_data["uid"] = uid

    username = f"@{user.username}" if user.username else "بدون username"

    keyboard = [
        [
            InlineKeyboardButton(
                "✅ قبول",
                callback_data=f"approve:{user.id}",
            ),
            InlineKeyboardButton(
                "❌ رفض",
                callback_data=f"reject:{user.id}",
            ),
        ]
    ]

    admin_message = (
        "🔔 طلب تحقق جديد\n\n"
        f"👤 المستخدم: {username}\n"
        f"🆔 Telegram ID: {user.id}\n"
        f"💱 MEXC UID: {uid}\n\n"
        "يرجى التحقق من UID في MEXC."
    )

    await context.bot.send_message(
        chat_id=ADMIN_ID,
        text=admin_message,
        reply_markup=InlineKeyboardMarkup(keyboard),
    )

    await update.message.reply_text(
        "✅ تم استلام UID الخاص بك.\n\n"
        "⏳ طلبك الآن قيد المراجعة.\n"
        "بعد التحقق والموافقة، سيصلك رابط قناة التوصيات تلقائيًا."
    )


# =========================
# قبول / رفض الطلب
# =========================

async def admin_action(update: Update, context: ContextTypes.DEFAULT_TYPE):

    query = update.callback_query
    await query.answer()

    if query.from_user.id != ADMIN_ID:
        await query.answer(
            "❌ ليس لديك صلاحية.",
            show_alert=True,
        )
        return

    action, user_id = query.data.split(":")
    user_id = int(user_id)

    if action == "approve":

        await context.bot.send_message(
            chat_id=user_id,
            text=(
                "🎉 تم التحقق من حسابك بنجاح!\n\n"
                "يمكنك الآن الدخول إلى قناة توصيات التداول الفوري 👇"
            ),
            reply_markup=InlineKeyboardMarkup(
                [
                    [
                        InlineKeyboardButton(
                            "🚀 دخول قناة التوصيات",
                            url=SIGNALS_LINK,
                        )
                    ]
                ]
            ),
        )

        await query.edit_message_text(
            query.message.text + "\n\n✅ تمت الموافقة وإرسال الرابط للمستخدم."
        )

    elif action == "reject":

        await context.bot.send_message(
            chat_id=user_id,
            text=(
                "❌ لم تتم الموافقة على طلبك.\n\n"
                "يرجى التأكد من بيانات التسجيل وUID ثم التواصل معنا."
            ),
        )

        await query.edit_message_text(
            query.message.text + "\n\n❌ تم رفض الطلب."
        )


# =========================
# تشغيل البوت
# =========================

def main():

    if not BOT_TOKEN:
        raise ValueError("BOT_TOKEN غير موجود")

    application = Application.builder().token(BOT_TOKEN).build()

    application.add_handler(CommandHandler("start", start))

    application.add_handler(
        CallbackQueryHandler(
            check_subscription,
            pattern="^check_subscription$",
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            request_uid,
            pattern="^send_uid$",
        )
    )

    application.add_handler(
        CallbackQueryHandler(
            admin_action,
            pattern="^(approve|reject):",
        )
    )

    application.add_handler(
        MessageHandler(
            filters.TEXT & ~filters.COMMAND,
            receive_uid,
        )
    )

    application.run_polling()


if __name__ == "__main__":
    main()
